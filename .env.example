# Non-secret deployment settings. Copy to .env and edit every placeholder.
# This is also a shell file: keep values single-quoted and source only your own
# reviewed file. Do not paste passwords, tokens, or shell commands here.
# Docker stack deploy does NOT load .env automatically. Before each deploy:
#   set -a; . ./.env; set +a

# Image you build and push to your own registry; no public image is provided.
BRIDGE_IMAGE='registry.example.com/your-namespace/loop-event-bridge:replace-with-version'
BRIDGE_DOMAIN='bridge.example.com'

# Existing Traefik v3 setup; this stack does not install/configure Traefik.
TRAEFIK_NETWORK='replace-with-existing-overlay-network'
TRAEFIK_ENTRYPOINT='replace-with-existing-https-entrypoint'
TRAEFIK_CERT_RESOLVER='replace-with-existing-certificate-resolver'

# Label exactly ONE Linux Swarm node with loop-event-bridge=<this value>.
BRIDGE_NODE_LABEL='primary'
# Create this persistent local volume on that node before the first deployment.
BRIDGE_DATA_VOLUME='loop-event-bridge-data'

# Names of secrets YOU create in Swarm. These are names, never secret values.
OWNER_PASSWORD_SECRET='loop-event-bridge-owner-v1'
GITHUB_TOKEN_SECRET='loop-event-bridge-github-v1'
GITHUB_ACCOUNT='replace-with-your-github-login'

# Choose a non-secret client ID, then enter this same value in ChatGPT's
# predefined PUBLIC client setup after deploying. No OAuth client secret.
OAUTH_CLIENT_ID='loop-event-bridge-chatgpt'
# Documented stable ChatGPT redirect for issuer-aware servers like this one.
# This lets you deploy metadata first. BEFORE approving the connection, compare
# it with the exact redirect shown in ChatGPT's management page. If different,
# copy that URI here and redeploy. Token endpoint authentication method: none.
# https://developers.openai.com/plugins/build/auth#redirect-url
OAUTH_REDIRECT_URI='https://chatgpt.com/connector_platform_oauth_redirect'

# Leave empty for discovery. Subscription errors report requestedHost.
# Verify that destination, add its exact hostname, and redeploy; no wildcards.
# Multiple verified hosts can be comma-separated.
CALLBACK_HOSTS=''
# Default 300 seconds, minimum 60; GitHub may require a longer interval.
POLL_INTERVAL_SECONDS='300'
