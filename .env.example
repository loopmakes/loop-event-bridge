# No secrets belong in this file. Copy to .env and use your actual values.
BRIDGE_DOMAIN=bridge.example.com
TRAEFIK_NETWORK=replace-with-your-existing-network
TRAEFIK_ENTRYPOINT=replace-with-your-https-entrypoint
TRAEFIK_CERT_RESOLVER=replace-with-your-existing-resolver
# Set a predefined public OAuth client ID in the ChatGPT server configuration.
# Copy the exact registered value and redirect URI; never use guessed callbacks.
OAUTH_CLIENT_ID=replace-with-your-client-id
OAUTH_REDIRECT_URI=https://chatgpt.com/replace-with-exact-management-page-redirect
# Start empty to discover the server; subscriptions fail closed until you allow
# the actual callback hostname returned in the subscription request/error.
CALLBACK_HOSTS=
GITHUB_REPOSITORY=colthreepv/symmetro
GITHUB_AUTHOR=loopmakes
POLL_INTERVAL_SECONDS=300
